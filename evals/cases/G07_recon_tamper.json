{
  "id": "G07",
  "name": "recon_tamper",
  "title": "Usage Fees Jun 2026 + 1,000.00 in the leaf only",
  "protects": "Reconciliation catches a single edited cell. Controls C1, C3, C7 and C8 must fail in Jun 2026 by exactly 1,000.00 with cell references; no other month fails; the run is BLOCKED and writes nothing downstream.",
  "plan_ref": "PLAN.md 8.1 G07",
  "runs": [
