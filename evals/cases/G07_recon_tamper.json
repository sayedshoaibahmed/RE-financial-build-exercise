            }
          },
          {
            "control_id": "C3",
            "period": "2026-06",
            "difference": "1000.00",
            "oracle": {
              "difference": "transform:amount"
            }
          },
          {
            "control_id": "C7",
            "period": "2026-06",
            "difference": "1000.00",
            "oracle": {
              "difference": "transform:amount"
            }
          },
          {
            "control_id": "C8",
            "period": "2026-06",
            "difference": "1000.00",
            "oracle": {
              "difference": "transform:amount"
            }
          }
        ],
        "failed_periods_only": [
